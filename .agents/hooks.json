{
  "closed-loop-write-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node .agents/hooks/governance_guard.mjs pre-tool",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .agents/hooks/governance_guard.mjs stop",
        "timeout": 10
      }
    ]
  }
}
