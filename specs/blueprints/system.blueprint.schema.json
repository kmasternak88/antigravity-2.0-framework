{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Antigravity Master System Blueprint Contract Schema v8.2",
  "type": "object",
  "required": [
    "metadata",
    "competitive_advantages",
    "architecture_topology",
    "ast_processing_pipeline",
    "data_dictionary",
    "governance_criteria"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["name", "slug", "target_archetype", "target_stack", "version", "blueprint_hash"],
      "properties": {
        "name": { "type": "string" },
        "slug": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "target_archetype": { "type": "string" },
        "target_stack": { "type": "string" },
        "version": { "type": "string" },
        "blueprint_hash": { "type": "string" },
        "created_at": { "type": "number" }
      }
    },
    "competitive_advantages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "advantage", "competitor_pain_point_solved", "evidence_reference"],
        "properties": {
          "id": { "type": "string" },
          "advantage": { "type": "string" },
          "competitor_pain_point_solved": { "type": "string" },
          "evidence_reference": { "type": "string" }
        }
      }
    },
    "architecture_topology": {
      "type": "object",
      "required": ["layers", "components"],
      "properties": {
        "layers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "name", "layer", "allowed_paths", "srp_max_lines", "checksum"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "layer": { "type": "string" },
              "allowed_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "srp_max_lines": { "type": "integer", "maximum": 40 },
              "checksum": { "type": "string" }
            }
          }
        }
      }
    },
    "ast_processing_pipeline": {
      "type": "object",
      "required": ["parser", "transformers", "caching_strategy"],
      "properties": {
        "parser": { "type": "string" },
        "transformers": {
          "type": "array",
          "items": { "type": "string" }
        },
        "caching_strategy": { "type": "string" }
      }
    },
    "data_dictionary": {
      "type": "object",
      "required": ["entities", "tables"],
      "properties": {
        "entities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "primary_key", "indexes"],
            "properties": {
              "name": { "type": "string" },
              "primary_key": { "type": "string" },
              "indexes": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "governance_criteria": {
      "type": "object",
      "required": ["max_query_time_ms", "max_memory_mb", "standards_checklist"],
      "properties": {
        "max_query_time_ms": { "type": "number" },
        "max_memory_mb": { "type": "number" },
        "max_autoload_entry_bytes": { "type": "integer" },
        "standards_checklist": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
